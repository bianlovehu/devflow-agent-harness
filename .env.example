# 文件用途：列出服务端配置项及本地开发默认值，不包含真实密钥。
# Local development only. Never commit .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow-local
# Repository source: fixture (offline demo) or github (read-only GitHub adapter).
DATA_SOURCE=fixture
# database is the normal mode; files supports offline read-only fixture browsing.
FIXTURE_STORAGE=database
# 浏览与健康检查不调用模型；创建分析任务时由 worker 调用所选供应商。
# Optional fine-grained token for selected repositories only.
# Read-only permissions: Metadata, Contents, Pull requests, Issues and Actions.
# Public repository browsing can work without a token; access limits still apply.
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=30
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# fake 是无需密钥的离线演示；真实模式可选 aliyun 或 deepseek。
MODEL_PROVIDER=fake
ANALYSIS_EXECUTOR=agent
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_OUTPUT_TOKENS=20000
CONTEXT_INPUT_TOKENS=120000
# 阿里云百炼：填写控制台对应工作空间与地域的官方兼容模式 Base URL。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=deepseek-v4.1-flash

# 租约过期进入待处理；simulation 执行器保留用于第二周通道回归。
WORKER_LEASE_SECONDS=30
WORKER_POLL_SECONDS=1
SIMULATION_STEP_SECONDS=3

# 全项目累计预算，保守忙时目录价；不自动重置。
BUDGET_TOTAL_CNY=200
BUDGET_WARNING_CNY=140
BUDGET_STOP_CNY=180
