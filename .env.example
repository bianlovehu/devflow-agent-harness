# 文件用途：列出服务端配置项及本地开发默认值，不包含真实密钥。
# Local development only. Never commit .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow-local
# Repository source: fixture (offline demo) or github (adapter arrives in step 5).
DATA_SOURCE=fixture
# database is the normal mode; files supports offline read-only fixture browsing.
FIXTURE_STORAGE=database
# Optional: only an explicit probe or future analysis calls the model.
GITHUB_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
